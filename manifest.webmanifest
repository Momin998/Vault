{
  "name": "Vault - Secure Wallet Tracker",
  "short_name": "Vault",
  "description": "A mobile-ready wallet tracker for deposits, withdrawals, balance, and ledger history.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#080b14",
  "theme_color": "#080b14",
  "orientation": "portrait",
  "categories": [
    "finance",
    "productivity"
  ],
  "icons": [
    {
      "src": "icons/vault-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/vault-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/vault-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/vault-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
